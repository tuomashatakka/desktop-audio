{
  "name": "desktop-audio",
  "productName": "desktop-audio",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint ./src --config config/eslint.config.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:ui": "vitest --ui --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright/playwright.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dev:web": "VITE_BRIDGE=browser vite --config config/vite/renderer.config.ts",
    "build:web": "VITE_BRIDGE=browser vite build --config config/vite/renderer.config.ts"
  },
  "keywords": [],
  "author": {
    "name": "tuomashatakka",
    "email": "tuomas.hatakka@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.1",
    "@electron-forge/plugin-fuses": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/animejs": "3.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "electron": "41.10.4",
    "eslint": "10.1.0",
    "jsdom": "28.1.0",
    "playwright": "1.58.2",
    "typescript": "^6.0.3",
    "vite": "8.0.3",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.13.23",
    "better-sqlite3": "^12.8.0",
    "disposable-events": "^1.0.0",
    "electron-squirrel-startup": "1.0.1",
    "mpris-service": "^2.1.2",
    "music-metadata": "11.12.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite-plugin-mkcert": "^2.0.0"
  },
  "patchedDependencies": {
    "fd-slicer@1.1.0": "patches/fd-slicer@1.1.0.patch"
  },
  "config": {
    "forge": "./config/forge.config.ts"
  }
}
